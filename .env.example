# Copy to .env to override defaults. On Render, set these as environment variables
# in the dashboard (or via the blueprint below) instead.

# Postgres connection string (Neon/Supabase/Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Change this to a long random string in production
JWT_SECRET=change-me-in-production-please

# App name shown in API root
APP_NAME=Splitwise Clone

# Comma-separated origins allowed by CORS
CORS_ORIGINS=*
